{
  "manifest_version": 3,
  "name": "JCR · Comprovantes no Conta Azul",
  "version": "0.4.1",
  "description": "Recebe do robô de conciliação (Portal JCR) os comprovantes das baixas e ajuda a anexá-los nos lançamentos do Conta Azul.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://jcrjuliana2111-crypto.github.io/jcr-fiscal/*"
      ],
      "js": [
        "portal.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.contaazul.com/*"
      ],
      "js": [
        "conciliacao-core.js",
        "contaazul.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "128": "icone.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
