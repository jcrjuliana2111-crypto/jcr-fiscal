{
	admin off
	auto_https off
}

:{$PORT} {
	# Saúde (Render): mostra só a versão da calculadora e da base, sem chave
	handle /saude {
		rewrite * /api/calculadora/dados-abertos/versao
		reverse_proxy 127.0.0.1:8080
	}
	# Todo o resto só com a chave que a Edge Function do portal envia
	@semchave not header X-Chave-RTC {$RTC_CHAVE}
	handle @semchave {
		respond "chave invalida" 401
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
